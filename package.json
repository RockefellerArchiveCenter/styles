{
  "name": "rac-styles",
  "type": "module",
  "version": "0.1.0",
  "description": "rac style library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockefellerArchiveCenter/styles.git"
  },
  "license": "MIT",
  "main": "index.js",
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "jest": "^29.7.0",
    "postcss": "^8.4.41",
    "postcss-cli": "^11.0.0",
    "pre-commit": "^1.2.2",
    "sass-true": "^8.0.0",
    "stylelint": "^16.11.0",
    "stylelint-config-css-modules": "^4.4.0",
    "stylelint-config-sass-guidelines": "^12.0.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "pre-commit": [
    "lint"
  ],
  "scripts": {
    "compile": "sass stylesheets/main.scss dist/main.min.css --no-source-map --style=compressed && postcss dist/main.min.css --replace --use autoprefixer",
    "lint": "npx stylelint 'stylesheets/**/*.scss'",
    "lint-fix": "npx stylelint 'stylesheets/**/*.scss' --fix",
    "test": "jest --testRegex test_ --env=node --passWithNoTests",
    "storybook": "storybook dev",
    "build-storybook": "storybook build"
  },
  "browserslist": [
    "> 2%"
  ],
  "devDependencies": {
    "@storybook/addon-a11y": "9.0.0",
    "@storybook/addon-docs": "9.0.0",
    "@storybook/addon-links": "9.0.0",
    "@storybook/html": "9.0.0",
    "@storybook/html-vite": "9.0.0",
    "@whitespace/storybook-addon-html": "9.0.0",
    "handlebars": "^4.7.8",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-syntax-highlighter": "^15.5.0",
    "sass": "^1.77.8",
    "storybook": "9.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.0.0"
  }
}
