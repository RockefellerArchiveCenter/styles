{
  "name": "rac-styles",
  "version": "0.1.0",
  "description": "rac style library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RockefellerArchiveCenter/styles.git"
  },
  "license": "MIT",
  "main": "index.js",
  "dependencies": {
    "autoprefixer": "^10.4.8",
    "jest": "^28.1.3",
    "postcss": "^8.4.16",
    "postcss-cli": "^10.0.0",
    "pre-commit": "^1.2.2",
    "sass-true": "^6.1.0",
    "stylelint": "^14.10.0",
    "stylelint-a11y": "^1.2.3",
    "stylelint-config-css-modules": "^4.1.0",
    "stylelint-config-sass-guidelines": "^9.0.1",
    "stylelint-config-standard": "^27.0.0"
  },
  "pre-commit": [
    "lint"
  ],
  "scripts": {
    "compile": "sass stylesheets/main.scss dist/main.min.css --no-source-map --style=compressed && postcss dist/main.min.css --replace --use autoprefixer",
    "lint": "npx stylelint 'stylesheets/**/*.scss'",
    "lint-fix": "npx stylelint 'stylesheets/**/*.scss' --fix",
    "test": "jest --testRegex test_ --env=node --passWithNoTests",
    "storybook": "storybook dev",
    "build-storybook": "storybook build"
  },
  "browserslist": [
    "> 2%"
  ],
  "devDependencies": {
    "@chromatic-com/storybook": "^1",
    "@storybook/addon-a11y": "^8.2.5",
    "@storybook/addon-actions": "^8.2.5",
    "@storybook/addon-docs": "^8.2.5",
    "@storybook/addon-essentials": "^8.2.5",
    "@storybook/addon-links": "^8.2.5",
    "@storybook/addon-webpack5-compiler-swc": "^1.0.4",
    "@storybook/html": "^8.2.5",
    "@storybook/html-webpack5": "^8.2.5",
    "@storybook/preset-scss": "^1.0.3",
    "@whitespace/storybook-addon-html": "^6.1.1",
    "css-loader": "^6.8.1",
    "handlebars": "^4.7.8",
    "handlebars-loader": "^1.7.3",
    "prettier": "^3.3.3",
    "react-syntax-highlighter": "^15.5.0",
    "sass": "^1.54.4",
    "sass-loader": "^13.3.2",
    "storybook": "^8.2.5",
    "style-loader": "^3.3.3"
  },
  "bugs": {
    "url": "https://github.com/RockefellerArchiveCenter/styles/issues"
  },
  "homepage": "https://github.com/RockefellerArchiveCenter/styles#readme"
}
